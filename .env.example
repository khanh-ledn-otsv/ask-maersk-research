# Required: the Ask Maersk page to open for a recording.
ASK_MAERSK_URL=https://www.maersk.com/

# Optional recording configuration.
RESEARCH_OUTPUT_DIR=data/runs
RESEARCH_BROWSER_PROFILE_DIR=.research/browser-profile
# ASK_MAERSK_ASSISTANT_SELECTOR=[data-message-author-role="assistant"]
# ASK_MAERSK_LOADING_SELECTOR=[role="progressbar"]
RESEARCH_HEADLESS=false
LOG_LEVEL=info

# Optional analysis configuration. Recording does not require these values.
# OPEN_AI_API_KEY=your-api-key
RESEARCH_ANALYSIS_MODEL=gpt-5.4-mini
RESEARCH_ANALYSIS_REASONING_EFFORT=none
