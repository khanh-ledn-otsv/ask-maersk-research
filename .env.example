# Required: the Ask Maersk page to open for a recording.
ASK_MAERSK_URL=https://www.maersk.com/

# Optional recording configuration.
RESEARCH_OUTPUT_DIR=data/runs
RESEARCH_BROWSER_PROFILE_DIR=.research/browser-profile
# ASK_MAERSK_ASSISTANT_SELECTOR=[data-message-author-role="assistant"]
# CSS selector for UI regions that Playwright must black out in screenshots.
# ASK_MAERSK_SENSITIVE_SELECTOR=input, textarea, [data-sensitive="true"]
# Comma-separated authorized customer identifiers to redact from text and screenshots.
# ASK_MAERSK_CUSTOMER_IDENTIFIERS=CUSTOMER-123456,SHIPMENT-987654
RESEARCH_HEADLESS=false
LOG_LEVEL=info
